# ============================================================
# Segue-me V2 — Variáveis de Ambiente
# Copie este arquivo para ".env" e ajuste conforme o ambiente.
# (.env NÃO é versionado; este .env.example SIM)
# ============================================================

# Porta HTTP em que o servidor Express irá escutar
PORT=3000

# Dialeto do Sequelize
DB_DIALECT=sqlite

# Caminho do arquivo do banco de dados
# (relativos são resolvidos a partir da raiz do projeto)
DB_STORAGE=./database.sqlite

# Segredo para assinatura dos tokens JWT (autenticação RF01)
# ⚠️ Troque por um segredo forte e único em produção
JWT_SECRET=segueme_secret_key_2026

# Ambiente da aplicação: "development" | "production"
# ⚠️ Em "production" o seed do Admin padrão (admin@segueme.com.br)
#    é BLOQUEADO e o CORS passa a exigir FRONTEND_URL.
NODE_ENV=development

# Senha usada pelo seed do Admin padrão (admin@segueme.com.br).
# É lida pelo src/server.js em seedAdminPadrao() — fora do código-fonte.
# ⚠️ Credencial de DESENVOLVIMENTO: troque por uma senha forte e,
#    em produção, defina manualmente o admin (o seed é bloqueado).
ADMIN_PADRAO_SENHA=admin123

# Origem do frontend liberada no CORS (segurança).
# Pode receber uma lista separada por vírgula.
# Local: deixa como está ou apague (cai em '*' com aviso).
# Produção: OBRIGATÓRIO definir a URL real (ex.: https://painel.segueme.com.br)
FRONTEND_URL=http://localhost:3000

# Trust proxy: informe o nº de proxies à frente do app (1 = Nginx/Heroku).
# Padrão quando VAZIO: 1 (topologia de produção — rate limit por IP correto).
# ATENÇÃO: se a aplicação for exposta DIRETAMENTE (sem proxy), use TRUST_PROXY=0
# para desligar — senão o X-Forwarded-For forjado contorna o rate limit de login.
TRUST_PROXY=
